# HL_OSCAR_MIN_DAY_VOLUME_USD=100000
# HL_OSCAR_POLL_MS=60000
# HL_OSCAR_CANDLE_REFRESH_MS=300000
# HL_OSCAR_DRAWDOWN_STOP_USD=500 — live-only halt (0=off)
# HL_OSCAR_DENYLIST= — override default denylist (comma-sep)
# HL_OSCAR_WHITELIST= — optional allowlist; default = all perps except denylist + min volume
