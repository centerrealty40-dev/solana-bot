# QN_FEATURE_BUDGET_LIVE_SEND=4000000

# W8.0 Phase 7 — replay live_position_* (SPL journal reconcile удалён в 1.11.45)
# LIVE_REPLAY_ON_BOOT=1
# LIVE_REPLAY_MAX_FILE_BYTES=26214400 — если файл журнала больше, replay только хвост (см. RUNBOOK_LIVE_OSCAR_PHASE7.md)
# LIVE_REPLAY_TAIL_LINES= — опционально: только последние N строк журнала
# LIVE_REPLAY_SINCE_TS= — опционально: только события с ts ≥ (unix ms)
# LIVE_RECONCILE_TX_SAMPLE_N=0 — последние N confirmed tx из журнала → getTransaction (0 = выкл.; см. RUNBOOK_LIVE_OSCAR_PHASE7 §9)
# LIVE_RECONCILE_BLOCK_MAX_MS=0 — emergency TTL для exposure block (parity); 0 = выкл.
# LIVE_SKIP_BUY_OPEN_WALLET_MINT_MIN_USD=0 — live-only `buy_open`: не покупать mint, если на кошельке уже ≥ N USD по оценке (RPC баланс × цена); 0 = выкл.
# LIVE_POST_CLOSE_TAIL_SWEEP_DELAY_MS=60000 — после полного close: через N мс проверить баланс mint и при необходимости продать хвост (`sell_full`). 0 = выкл.
# LIVE_POST_CLOSE_TAIL_SWEEP_MIN_USD=0.05 — нижняя подсказка notional для крошечных хвостов (реальный размер — из chain)
# LIVE_TAIL_FLUSH_THRESHOLD_USD=100 — после partial exit: если остаток на кошельке < N USD, продать 100% баланса mint. Post-close sweep продаёт любой положительный остаток.
# LIVE_PERIODIC_SELF_HEAL_MS=1800000 — periodic safe hygiene: chain-only tail sweep + stale-open diagnostics. 0 = выкл.
# LIVE_PERIODIC_SWEEP_MIN_USD=0.25 — не трогать chain-only хвосты ниже оценки USD.
# LIVE_PERIODIC_SWEEP_UNKNOWN_CHAIN_ONLY=0 — 1 = продавать любые SPL не в open выше min USD (осторожно: airdrops/scam).
# LIVE_PERIODIC_STUCK_FORCE_CLOSE_ENABLED=0 — default: НЕ продавать live open только по возрасту. 1 = ручной opt-in старого PERIODIC_HEAL force-close.
# LIVE_PERIODIC_STUCK_GRACE_HOURS=0.5 — используется только при LIVE_PERIODIC_STUCK_FORCE_CLOSE_ENABLED=1.

# Двухногий вход live (вторая нога после LIVE_ENTRY_SCALE_IN_DELAY_MS): Jupiter implied vs якорь первой ноги.
# LIVE_ENTRY_SCALE_IN_ENABLED=0
# LIVE_ENTRY_SCALE_IN_DELAY_MS=5000
# LIVE_ENTRY_SCALE_IN_CORRIDOR_PCT=3 — симметричный fallback, если не заданы UP/DOWN
# LIVE_ENTRY_SCALE_IN_CORRIDOR_UP_PCT=1 — допуск вверх от якоря первой ноги, п.п.
# LIVE_ENTRY_SCALE_IN_CORRIDOR_DOWN_PCT=2 — допуск вниз от якоря, п.п.
# LIVE_ENTRY_SCALE_IN_OUT_OF_CORRIDOR_POLL_MS=30000 — пауза между проверками, пока цена вне коридора
# LIVE_ENTRY_SCALE_IN_MAX_SWAP_ATTEMPTS=8 — ретраи котировки/свопа при ошибках (не принудительная вторая нога)
# LIVE_ENTRY_SCALE_IN_RETRY_BACKOFF_MS=2000

# W8.0-p7.1 — цепочные якоря в журнале + паритет paper/live notional (CHANGELOG 1.11.23; RUNBOOK §12)
# LIVE_REPLAY_TRUST_GHOST_POSITIONS=0 — 1 = применять live_position_* без entryLegSignatures (опасно; только ручной режим)
# LIVE_STRICT_NOTIONAL_PARITY=1 — live: PAPER_POSITION_USD vs LIVE_ENTRY_NOTIONAL_USD / LIVE_MAX_POSITION_USD
# LIVE_ANCHOR_VERIFY_ON_BOOT=1 — live: проверка entryLegSignatures через getTransaction (без блокировки новых входов при RPC pending)

# Phase 7 дополнение — восстановление live_position_* если buy попал в блок, а журнал пометил execution_result как failed (confirm_timeout и т.п.)
# LIVE_REPAIR_MISSED_OPENS=1 — по умолчанию в коде включено; 0|false выключает проход при старте live-oscar
# LIVE_REPAIR_MISSED_OPEN_MAX_AGE_MS=604800000 — семь суток (не задано ⇒ то же значение по умолчанию)

# ============================================================
# W6.5 — three live dip strategies (DipRunner / Oscar / Dno)
# ============================================================
# Whale silence: capitulator only if last sell on this mint was ≥ N min ago.
# 0 = OFF. PM2 apps use 10.
PAPER_DIP_WHALE_SILENCE_MIN=10

# Heartbeat-based healthcheck tail scan (see scripts-tmp/paper2-healthcheck.mjs).
# PAPER2_MAX_STALE_MIN уже задан выше в блоке W6.4.
PAPER2_HEALTH_TAIL_LINES=1500

# ============================================================
# Stealth copy-trader — один кошелёк, задержанный вход/выход
#   npm run copy-trader
# По умолчанию paper (JSONL журнал). live пока логирует skip (см. executor.ts).
# ============================================================
# COPY_TRADER_WALLET_SECRET=data/live/live-oscar-risky.keypair.json — Phantom base58 или JSON (gitignore)
# COPY_TRADER_WALLET_PUBKEY=HoFKBH9novJha1rzkHTBRqPrMbXtRNQL3wgJUWqfmp19
# COPY_TRADER_USE_RISKY_WALLET=1 — разрешить бывший live-oscar-risky keypair
# COPY_TRADER_TARGET_WALLET= — лидер (кого копируем); или файл ниже
# COPY_TRADER_TARGET_WALLET_PATH=data/copytrader/target-wallet.txt
# COPY_TRADER_RPC_URL= — иначе SA_RPC_HTTP_URL / SA_RPC_URL
# COPY_TRADER_EXECUTION_MODE=paper — paper | dry_run | live
# COPY_TRADER_STRICT_ISOLATION=1 — запрет общих путей/ключей с live-oscar (дефолт вкл.)
# COPY_TRADER_JOURNAL_PATH=data/copytrader/journal.jsonl — НЕ pt1-oscar-live.jsonl
# COPY_TRADER_STATE_PATH=data/copytrader/state.json
# COPY_TRADER_WALLET_SECRET= — только для live; отдельный keypair, НЕ LIVE_WALLET_SECRET
# COPY_TRADER_POSITION_USD=300 — первый вход (фикс., если INITIAL_MIRROR_RATIO=0)
# COPY_TRADER_INITIAL_MIRROR_RATIO=0.5 — вход = доля от USD-покупки лидера (0 = фикс. POSITION_USD)
# COPY_TRADER_MIN_MIRROR_ENTRY_USD=100 — пол на зеркальный вход (0 = без пола)
# COPY_TRADER_ENTRY_LOW_MCAP_MIN_USD=30000 — вместе с MAX/POSITION: фикс. клип на low-mcap (приоритет над mirror)
# COPY_TRADER_ENTRY_LOW_MCAP_MAX_USD=150000
# COPY_TRADER_ENTRY_LOW_POSITION_USD=50
# COPY_TRADER_MAX_POSITION_USD=3000 — потолок позиции; adds пропорционально лидеру до этого cap
# COPY_TRADER_MAX_POSITION_USD=190 — потолок notional на mint (100 + до 3×30)
# COPY_TRADER_MAX_ADDS_PER_MINT=3
# COPY_TRADER_MIN_PROPORTIONAL_ADD_USD=3 — мин. наш add после пропорции
# COPY_TRADER_MIN_PROPORTIONAL_SELL_FRACTION=0.005 — игнор микро-продаж лидера (<0.5%)
# COPY_TRADER_POLL_INTERVAL_MS=12000 — опрос новых tx лидера
# COPY_TRADER_TICK_INTERVAL_MS=2000 — обработка очередей buy/sell
# COPY_TRADER_BUY_DELAY_MS=30000 — ~30 сек до первой попытки покупки
# COPY_TRADER_BUY_DELAY_SKIP_MAX_PREMIUM_PCT=0 — 0=off; N=купить сразу если mark ≤ +N% к лидеру
# COPY_TRADER_BUY_RETRY_WINDOW_MS=7200000 — повторять eval/exec каждые ~2s до 2ч после due
# COPY_TRADER_BUY_RETRY_DEFER_LOG_MS=60000 — throttle journal buy_deferred
# COPY_TRADER_SELL_RETRY_WINDOW_MS=7200000 — повторять sell при slippage до 2ч
# COPY_TRADER_SELL_RETRY_INTERVAL_MS=6000 — пауза между попытками sell
# COPY_TRADER_SELL_RETRY_DEFER_LOG_MS=30000 — throttle journal sell_deferred
# COPY_TRADER_SELL_DELAY_MIN_MS=20000 — мин. задержка после продажи лидера
# COPY_TRADER_SELL_DELAY_MAX_MS=30000 — макс. задержка (случайно в диапазоне)
# COPY_TRADER_SELL_DELAY_SKIP_MAX_DROP_PCT=0 — 0=off; N=delay только если mark уже вниз >N% от entry
# COPY_TRADER_BUY_PRICE_MAX_PREMIUM_PCT=3 — купить только если цена ≤ leader + N%
# COPY_TRADER_MIN_LEADER_BUY_USD=50 — игнорировать мелкие покупки лидера
# COPY_TRADER_MIN_LIQUIDITY_USD=15000
# COPY_TRADER_MIN_MCAP_USD=0
# COPY_TRADER_MAX_MCAP_USD=0
# COPY_TRADER_MIN_PAIR_AGE_HOURS=0
# COPY_TRADER_MAX_OPEN_POSITIONS=5
# COPY_TRADER_SLIPPAGE_BPS=400
# --- selective copy gates (docs/strategy/copytrader/LEADER_8ZKG_AUDIT.md) ---
# COPY_TRADER_APP_NAME=copy-trader — heartbeat/fatal file name when several instances run
# COPY_TRADER_LEADER_GATES=0 — 1 включает гейты ниже (иначе они не применяются)
# COPY_TRADER_MIN_LEADER_PRIOR_SESSIONS=3 — сколько закрытых кругов лидера нужно по монете
# COPY_TRADER_MIN_LEADER_PRIOR_AVG_PCT=5 — и какой средний результат по ним
# COPY_TRADER_ENTRY_MIN_PAIR_AGE_HOURS=1 / COPY_TRADER_ENTRY_MAX_PAIR_AGE_HOURS=72
# COPY_TRADER_ENTRY_MIN_BUY_SELL_5M=1.05 — минимум buys/sells за 5 минут
# COPY_TRADER_ENTRY_MAX_CHASE_5M_PCT=15 — не входить после спайка больше N% за 5 минут
# COPY_TRADER_ENTRY_MIN_TURNOVER_5M=0.09 — объём за 5 минут к ликвидности пула
# COPY_TRADER_ENTRY_MIN_VOL_TO_MCAP_1H=0.33 — объём за час к капитализации
# COPY_TRADER_ENTRY_MIN_VOLUME_5M_USD=0 — абсолютный пол 5m USD volume (0=off; missing → skip)
# COPY_TRADER_VOL_FADE_CHECK_INTERVAL_MS=0 — период перепроверки объёма на открытых (0=off)
# COPY_TRADER_VOL_FADE_MIN_VOLUME_5M_USD=0 — полный выход если 5m vol ниже пола
# COPY_TRADER_VOL_FADE_DROP_PCT=0 — полный выход если vol упал на N% от входа
# COPY_TRADER_MIRROR_EARLY_TP_GAIN_PCT=0 — 0=off; N=+N% к entry → peel пока лидер не продал
# COPY_TRADER_MIRROR_EARLY_TP_SELL_FRACTION=0.5 — доля остатка на early TP
# COPY_TRADER_MIRROR_EARLY_TP_TICK_INTERVAL_MS=5000 — как часто смотреть mark
# COPY_TRADER_MIRROR_HOLD_CAP_MS=0 — 0=off; N=полный выход если сидим дольше N мс
# COPY_TRADER_MIRROR_HOLD_CAP_VOL_OK_MS=0 — 0=off; при живом 5m vol растянуть hold-cap до этого (напр. 30m→60m)
# COPY_TRADER_LEADER_FOLLOW_ONLY_MIN_MCAP_USD=1000000 — вместе с vol1h: вход без micro-gates + без hold-cap/vol-fade
# COPY_TRADER_LEADER_FOLLOW_ONLY_MIN_VOLUME_1H_USD=50000
# COPY_TRADER_ENTRY_CONTEXT_TTL_MS=60000 — кэш рыночного контекста входа
# COPY_TRADER_LEADER_HISTORY_TTL_MS=2592000000 — забывать историю монеты через N мс
# --- trail_runner exit (COPY_TRADER_EXIT_MODE=trail_runner) ---
# COPY_TRADER_TRAIL_ARM_PCT=8 — взвести трейлинг на +N%
# COPY_TRADER_TRAIL_GIVEBACK_PCT=8 — шаг отката от пика (как у Oscar half8)
# COPY_TRADER_TRAIL_TP_STEP_PCT=8 — лестница TP: +8/+16/+24… (0 = выкл)
# COPY_TRADER_TRAIL_TP_SELL_FRACTION=0.5 — доля остатка на каждой ступени TP
# COPY_TRADER_TRAIL_TRAIL_SELL_FRACTION=0.2 — доля остатка на каждом шаге трейла (1 = весь остаток)
# COPY_TRADER_TRAIL_KILL_PCT=50 — жёсткий выход при −N% от входа (0 = выкл)
# COPY_TRADER_TRAIL_TAKE_PROFIT_PCT=0 — устаревший полный TP; игнор при включённой лестнице
# COPY_TRADER_TRAIL_TIME_CAP_MS=0 — жёсткий выход по времени (0 = выкл)
# COPY_TRADER_TRAIL_TICK_INTERVAL_MS=5000 — как часто переоценивать открытые позиции
# --- quote (funding) asset ---
# COPY_TRADER_QUOTE_MINT=SOL — SOL | USDC | сырой mint; USDC отвязывает размер сделки от курса SOL
# COPY_TRADER_MIN_FEE_SOL_RESERVE=0.02 — при USDC: минимум нативного SOL на комиссии и ATA rent
# COPY_TRADER_TELEGRAM_ENABLED=1 — COPY_TRADER_TELEGRAM_* или TELEGRAM_*

# --- HL TWAP watch + live (hl-twap-telegram-watch) ---
# HL_TWAP_TELEGRAM_BOT_TOKEN=
# HL_TWAP_TELEGRAM_CHAT_ID=
# HL_TWAP_MIN_IMPACT_PCT_HOUR=2 — sole entry filter (≥2 %/h; policy floor 2 — do not set 0)
# HL_TWAP_MIN_MINUTES=16 — standard lane: skip whale TWAP ≤15m (short lane handles <15m separately)
# HL_TWAP_SHORT_ENABLED=1 — enable short TWAP lane (1–14m): instant exit before last whale 30s slice
# HL_TWAP_SHORT_MAX_MINUTES=15 — short lane applies when duration < this (default 15 → max 14m)
# HL_TWAP_SHORT_MIN_MINUTES=1
# HL_TWAP_MAX_MINUTES=120 — skip whale TWAP >2h
# HL_TWAP_EXIT_EARLY_MINUTES=10 — close N minutes before TWAP end (not before_last_cycle)
# HL_TWAP_CANCEL_EXIT_DELAY_MINUTES=5 — wait after whale TWAP cancel/error before closing (not on normal finish; aborted if whale restarts same coin)
# HL_TWAP_WHALE_DENYLIST= — optional comma-separated whale addresses to skip
# HL_TWAP_WHALE_BLOCKLIST= — optional extra serial-canceller blocks (merged with built-in list)
# HL_TWAP_FADE_WHALES= — comma-separated whales to fade (enter opposite side; overrides denylist for those addresses)
# HL_TWAP_BTC_ALIGNED_GATE=0 — strong-move aligned gate (off by default)
# HL_TWAP_BTC_ALIGNED_THRESH_PCT=1 — block long when BTC 1h <= -T%, short when >= +T%; |1h| < T → allow (default 1)
# HL_TWAP_BTC_GATE_MAX_STALE_MS=900000 — max Binance BTC kline age for aligned gate
# HL_TWAP_BTC_REFRESH_MS=300000 — BTC context refresh interval when gate enabled
# HL_TWAP_COIN_MOMENTUM_GATE=1 — gate A: block long when coin dd24h <= -HL_TWAP_COIN_MOMENTUM_DD24H_PCT (HL 1h candles)
# HL_TWAP_COIN_MOMENTUM_DD24H_PCT=5 — drawdown from 24h high threshold (default 5%)
# HL_TWAP_COIN_MOMENTUM_MAX_STALE_MS=900000 — max cache age for gate A snapshot
# HL_TWAP_LIVE_COIN_PRIOR_LOSS_BLOCK=1 — gate B: block long after any prior loss on same coin+side
# HL_TWAP_LIVE_LOSS_STREAK_COOLDOWN=1 — extra block after N consecutive losses (2h cooldown)
# HL_TWAP_LIVE_LOSS_STREAK_COUNT=2
# HL_TWAP_LIVE_LOSS_STREAK_COOLDOWN_HOURS=2
# HL_TWAP_LIVE_ENABLED=1
# HL_TWAP_LIVE_NOTIONAL_USD=800 — 7× tier margin fallback (collateral); gross ≈ margin × min(coin max, 7x)
# HL_TWAP_LIVE_MARGIN_LEV3_USD=1500 — margin when HL max leverage ≤3× (gross ≈ $4500)
# HL_TWAP_LIVE_MARGIN_LEV5_USD=1000 — margin when HL max leverage 4–5× (gross ≈ $5000)
# HL_TWAP_LIVE_MARGIN_LEV7_USD=800 — margin when HL max leverage ≥6× (gross ≈ $5600); defaults to NOTIONAL_USD
# HL_TWAP_LIVE_DYNAMIC_MARGIN=0 — fixed $800 margin per entry (prod default); set 1 to scale by open count
# HL_TWAP_LIVE_MARGIN_MAX_USD=800 — max margin when dynamic margin enabled
# HL_TWAP_LIVE_MARGIN_MIN_USD=800 — min margin (was 300 when dynamic scaled down at ≥5 opens)
# HL_TWAP_LIVE_DYNAMIC_MARGIN_MAX_AT=2
# HL_TWAP_LIVE_DYNAMIC_MARGIN_MIN_AT=5
# HL_TWAP_LIVE_DYNAMIC_MARGIN_DCA_RESERVE=2 — ladder DCA levels reserved when sizing
# HL_TWAP_MARGIN_RESERVE_USD=50 — collateral kept free on account for new opens
# HL_TWAP_LIVE_LEVERAGE=7 — capped per coin at HL max leverage when lower
# HL_TWAP_LIVE_COIN_MAX_LEGS=2 — max concurrent journal legs (incl. pending) per coin+side; 3rd TWAP blocked
# HL_TWAP_LIVE_MAX_BOOK_GROSS_USD=12000 — hard cap on exchange gross per coin+side (entries + DCA)
# HL_TWAP_LIVE_LADDER_STEP_PCT=2 — TP/DCA at ±2% Hyperliquid ROE (uPnL/margin), not raw price %
# HL_TWAP_LIVE_LADDER_SLICE_PCT=30 — each TP/DCA slice = 30% of current gross notional
# HL_TWAP_LIVE_EXIT_SLICES=10 — exit TWAP slices at liveCloseAtMs (0/1 = instant flatten)
# HL_TWAP_LIVE_EXIT_SLICE_INTERVAL_MS=30000 — ms between exit slices (align with HL TWAP 30s)
# HL_TWAP_LIVE_PRIVATE_KEY=
# HL_TWAP_MASTER_ADDRESS=
# HL_TWAP_LIVE_DRAWDOWN_STOP_USD=1000 — emergency flatten + halt when equity drops this much from trailing peak (0=off)
# HL_TWAP_LIVE_DRAWDOWN_CHECK_MS=60000 — poll account equity every 60s (includes unrealized PnL); peak = high-water mark
# HL_TWAP_LIVE_DRAWDOWN_CLEAR_HALT=1 — on restart: clear halt flag and reset peak to current equity
# HL_TWAP_LIVE_DRAWDOWN_STATE_PATH=data/hl-twap/drawdown-stop.json
# HL_TWAP_BALANCE_HOURLY_TELEGRAM=1 — hourly HL Total Balance (spot USDC + uPnL) to HL_TWAP_TELEGRAM_* chat; default on when live; first ping after UTC hour boundary (no startup spam)
# HL_TWAP_HEARTBEAT_MS=60000 — in-process liveness (default 60s → data/hl-twap/heartbeat.json)
# HL_TWAP_HEARTBEAT_PATH=data/hl-twap/heartbeat.json
# HL_TWAP_LAST_FATAL_PATH=data/hl-twap/last-fatal.json
# hl-twap-process-watch (PM2): HL_TWAP_WATCH_AUTO_RESTART=1 HL_TWAP_WATCH_TELEGRAM=1
# HL_TWAP_WATCH_HEARTBEAT_MAX_STALE_MS=300000 — restart + [ALERT][hl_twap_watch] if stale 5m
# strategy-process-watch (PM2): unified watchdog for hl-twap + live-oscar + copy-trader
# OPS_HEARTBEAT_DIR=data/ops-heartbeats — liveness files for PM2 watchdog (60s)

