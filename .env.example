CF_ACCOUNT_ID=
CF_API_TOKEN=
R2_BUCKET=solana-alpha-backups
# Encrypted secrets backup (gpg symmetric; scripts/ops/backup-secrets-encrypted.sh)
# Set one of: BACKUP_GPG_PASSPHRASE (min ~20 chars) or path outside git:
# BACKUP_GPG_PASSPHRASE_FILE=/home/salpha/.backup-gpg-passphrase
# Legacy S3-compatible keys (optional; not used by backup-db-r2-api.sh):
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

