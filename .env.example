# --- awakening-catcher (shadow dormant-low vol awakening; default OFF) ---
# Default ingress: AWAKENING_STREAM_SOURCE=ws (Alchemy logsSubscribe in-process, zero PG).
# Legacy: AWAKENING_STREAM_SOURCE=pg reads stream_events (avoid on shared LERA PG).
# AWAKENING_CATCHER_ENABLED=1
# AWAKENING_MODE=live
# AWAKENING_LIVE_ENTRY_ENABLED=1   # on live-lera10 only — consumes entry queue
# AWAKENING_VOL5M_MIN_USD=3000        # min live vol in last 5m bucket
# AWAKENING_VOL5M_SPIKE_MIN_MULT=8    # vol5m / prior-6h 5m-avg — early burst on quiet coin
# AWAKENING_VOL5M_SPIKE_VS_1H_MIN_MULT=4  # vol5m / prior-1h 5m-avg — reject mid-rally continuation
# AWAKENING_QUIET_PRIOR_5M_AVG_FLOOR_USD=50
# AWAKENING_MIN_VOL1H_USD=10000       # legacy; pass/fail uses spike mults, not vol1h floor
# AWAKENING_MAX_VOL24H_USD=800000     # dormancy: reject coins already hot over the day
# AWAKENING_MIN_POOL_AGE_HOURS=48    # coin must be >= 48h old (no fresh pump.fun)
# AWAKENING_VOL_VELOCITY_MIN=0.15    # journaled metric only (gate uses spike mults)
# AWAKENING_MIN_VOL1H_TO_VOL6H_RATIO=0.25  # legacy journaled; not a primary gate
# AWAKENING_MAX_VOL1H_PER_MCAP=2.0   # wash/cluster proxy: cap hourly turnover
# AWAKENING_MIN_PRICE_CHANGE_H24_PCT=0     # reject multi-day downhill (2-day dumps)
# AWAKENING_MIN_PRICE_CHANGE_H6_PCT=-5     # reject 6h downtrend
# AWAKENING_MIN_PRICE_CHANGE_H1_PCT=-5     # reject falling knife (1h)
# AWAKENING_MIN_PRICE_CHANGE_M5_PCT=2      # must be turning up right now
# AWAKENING_LEG_USD=10
# AWAKENING_TELEGRAM_ENABLED=1   # shadow: Telegram when signal caught (explains no live buy)
# AWAKENING_MAX_OPEN_POSITIONS=3
# AWAKENING_MAX_CANDIDATES_PER_TICK=5
# ALCHEMY_HTTP_URL=...  # WSS derived automatically for ws mode

