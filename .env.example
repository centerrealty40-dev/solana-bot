# SA_GRWS_RPC_URL=
# SA_GRWS_IGNORE_PROGRAM_IDS=
# SA_GRWS_GECKO_PAGES_MAX=2
# SA_GRWS_GECKO_PAGE_SLEEP_MS=650
# SA_GRWS_SIG_PAGES_MAX=5
# SA_GRWS_SIG_PAGE_LIMIT=100
# SA_GRWS_MAX_POOLS_PER_RUN=10
# SA_GRWS_MAX_TX_FETCHES_PER_POOL=30
# SA_GRWS_RPC_SLEEP_MS=250
# SA_GRWS_DRY_RUN=0
# SA_GRWS_INTERVAL_MS=600000
# SA_GRWS_HTTP_MAX_RETRIES=4
# SA_GRWS_HTTP_TIMEOUT_MS=15000
# SA_GRWS_SEED_POOLS_JSON=
# SA_GRWS_SEED_POOLS_PATH=/tmp/grws-seed-pools.json
# --- Pilot budget (QuickNode credits + Gecko Terminal HTTP) ---
# SA_GRWS_MAX_QUICKNODE_CREDITS_PER_DAY=1500000
# SA_GRWS_RPC_BUDGET_HEADROOM=0.94
# SA_GRWS_MAX_RPC_CALLS_PER_TICK=0
# SA_GRWS_BUDGET_STATE_PATH=data/sa-grws-budget-state.json
# SA_GRWS_GECKO_TARGET_CALLS_PER_MINUTE=28
# SA_GRWS_GECKO_MIN_INTERVAL_MS=0
# SA_GRWS_MAX_GECKO_HTTP_PER_DAY=40000
# SA_GRWS_BREADTH_FIRST=1
# Журнал тиков для npm run sa-grws-analytics (один JSON на строку):
# SA_GRWS_TICK_LOG_PATH=data/sa-grws-ticks.jsonl
# Пилот: серия сценариев + отчёт data/sa-grws-pilot-diagnose-report.json
# SA_GRWS_PILOT_PAUSE_MS=90000
# SA_GRWS_GECKO_ONLY_DIAGNOSTIC=1

# ============================================================
# W6.8 — Wallet ingest orchestrator (Gecko multi-lane, no DexScreener)
# Normative: docs/Smart Lottery V2/W6.8_wallet_ingest_orchestrator_gecko_multi_source.md
# Run: npm run sa-wallet-orchestrator -- --once | --daemon | --budget-report
# PM2: ecosystem.config.cjs — app `sa-wallet-orchestrator` (loads root `.env` via dotenv).
# ============================================================
# SA_ORCH_RPC_URL=
# SA_ORCH_COLLECTOR_ID=sa-wallet-orch
# SA_ORCH_COLLECTOR_SEMVER=0.1.0
# SA_ORCH_DRY_RUN=0
# SA_ORCH_STATE_PATH=data/wallet-orchestrator-state.json
# SA_ORCH_WEIGHTS_PATH=data/wallet-orchestrator-weights.json
# SA_ORCH_RESERVE_RPC_PCT=5
# lane = дневной RPC по весам на каждый lane; global = общий остаток дня на все lane (выжать лимит кредитов без «голодания» lane).
# SA_ORCH_BUDGET_MODE=global
# SA_ORCH_SCHEDULER_TICK_MS=10000
# SA_ORCH_DAILY_DEEP_HOUR_UTC=3
# SA_ORCH_GECKO_TARGET_CALLS_PER_MINUTE=24
# SA_ORCH_GECKO_MIN_INTERVAL_MS=0
# SA_ORCH_MAX_GECKO_HTTP_PER_DAY=40000
# SA_ORCH_MAX_QUICKNODE_CREDITS_PER_DAY=2200000
#
# W6.12 S01 — единый дневной ledger QuickNode-кредитов (таблица sa_qn_global_daily; миграция 0017).
# SA_QN_GLOBAL_LEDGER_ENABLED=1
# SA_QN_GLOBAL_CREDITS_PER_DAY=4000000
# Жёсткий потолок только для detective ingest (jsonRpcWithQnLedger → sa_qn_global_daily). Paper/live → qn-client / solana-rpc-meter (QUICKNODE_*).
# SA_QN_DETECTIVE_CAP_TELEGRAM=1
# При исчерпании — один ALERT/dень `[ALERT][detective-qn-day-cap]` и блок RPC detective до следующего UTC-дня.
# SA_QN_OPERATIONAL_POOL_PCT=70   # W6.13 — целевой операционный потолок (% от глобального дневного лимита)
# QUICKNODE_CREDITS_PER_SOLANA_RPC=30
# npm run sa-qn-global-report   # опционально SA_QN_REPORT_DATE=YYYY-MM-DD
# npm run sa-qn-budget-check    # W6.13 — сверка суммы объявленных потолков с ~70%
#
# W6.13 — объявленные потолки для предупреждений при старте (опционально):
# SA_BACKFILL_MAX_CREDITS_PER_DAY=
# SA_SIGSEED_MAX_CREDITS_PER_DAY=
# SA_WALLET_TRACE_MAX_CREDITS_PER_DAY=
# SA_BOT_ANALYZER_MAX_CREDITS_PER_DAY=450000
# SCAM_FARM_MAX_RPC_CREDITS_PER_DAY=   # иначе SCAM_FARM_RPC_BUDGET * QUICKNODE_CREDITS_PER_SOLANA_RPC при SCAM_FARM_ENABLE_RPC=1
#
# Hourly Telegram (root `.env.hourly`): секция sa_qn_global_daily
# HOURLY_APPEND_QN_LEDGER=1
#
# W6.12 S02 — wallet backfill (`wallet-backfill:run`; миграция 0018).
# Узкий пилот без стрима (дефолтные лимиты в `wallet-backfill-pilot.ts`): `npm run wallet-backfill:pilot`
# Верхняя оценка кредитов ≈ MAX_WALLETS×(SIG_PAGES+MAX_TX)×QUICKNODE_CREDITS_PER_SOLANA_RPC (факт ниже при раннем выходе по очереди).
# Узкий pilot по умолчанию (~40 кошельков/прогон) даёт малую свежую подачу — см. env в `install-detective-data-plane-salpha.sh` для дневной ширины без выхода за SA_BACKFILL_MAX_CREDITS_PER_DAY (~500k при типичных дефолтах биллинга).
# W6.12 S06 — gate enqueue (пустые — пороги выключены; на VPS cron задаёт 1500 / 2400 см. install-detective-data-plane-salpha.sh)
# При pending > GATE и без SOFT_CAP — enqueue полностью пропускается. SOFT_CAP ограничивает и без gate (headroom до потолка очереди).
# SA_BACKFILL_ENQUEUE_GATE_PENDING_MAX=1500
# SA_BACKFILL_ENQUEUE_SOFT_CAP=2400
# SA_BACKFILL_ENQUEUE_BATCH_DEFAULT=500 — резерв для будущей обёртки без литерала в argv
# SA_BACKFILL_METRICS_ENQUEUE_PREVIEW=500 — только для `npm run wallet-backfill:metrics`
# Лимиты двух pilot-слотов в метриках — SSOT `src/intel/wallet-backfill-cron-presets.ts` (= строки pilot в install-detective cron).
# SA_BACKFILL_ENABLED=0
# SA_BACKFILL_RPC_URL=
# SA_BACKFILL_MAX_WALLETS_PER_RUN=500
# SA_BACKFILL_SIG_PAGES_MAX=3
# SA_BACKFILL_MAX_TX_PER_WALLET=40
# SA_BACKFILL_RPC_SLEEP_MS=220
# SA_BACKFILL_HTTP_TIMEOUT_MS=15000
#
# W6.12 S03 — sigseed (mint → signatures → pump.fun swaps; миграция 0019).
# Cron: `scripts/cron/install-detective-data-plane-salpha.sh`.
# Пример под W6.13 при SA_QN_GLOBAL_CREDITS_PER_DAY=4M и пуле 70% (≈2.8M операционный потолок): orch 2.2M + backfill 500k + sigseed и др. — сверка `npm run sa-qn-budget-check`.
# SA_SIGSEED_ENQUEUE_ENABLED=1
# SA_SIGSEED_ENABLED=1
# SA_SIGSEED_RPC_URL=          # иначе SA_BACKFILL_RPC_URL / QUICKNODE_HTTP_URL
# SA_SIGSEED_ENQUEUE_BATCH=280
# SA_SIGSEED_ENQUEUE_MAX_PER_DAY=1200
# SA_SIGSEED_SWAPS_CEILING=120
# SA_SIGSEED_MAX_MINTS_PER_RUN=22
# SA_SIGSEED_SIG_PAGES_MAX=2
# SA_SIGSEED_MAX_TX_PER_MINT=16
# SA_SIGSEED_RPC_SLEEP_MS=380
# SA_SIGSEED_MAX_CREDITS_PER_RUN=60000
# SA_SIGSEED_HTTP_TIMEOUT_MS=15000
# SA_SIGSEED_MAX_CREDITS_PER_DAY=400000
# Пусто/default ≈400000 в коде worker; 0 = только глобальный cap и без строки в budget-check.
#
# W6.12 S04 — funding_source из money_flows (`wallet-funding:backfill`).
# SA_FUNDING_BACKFILL_ENABLED=0
# SA_FUNDING_LOOKBACK_DAYS=30
# SA_FUNDING_BATCH_SIZE=5000
# QUICKNODE_CREDITS_PER_SOLANA_RPC=30
# Пилот v2 (умеренно шире охват; дефолты в sa-wallet-orchestrator.mjs синхронизированы):
# SA_ORCH_MAX_RPC_PER_JOB=1200
# SA_ORCH_MAX_RPC_PER_POOL=180
# SA_ORCH_MAX_POOLS_PER_JOB=20
# SA_ORCH_SIG_PAGES_MAX=4
# SA_ORCH_MAX_TX_FETCHES_PER_POOL=18
# SA_ORCH_RPC_SLEEP_MS=220
# SA_ORCH_HTTP_TIMEOUT_MS=15000
# SA_ORCH_HTTP_MAX_RETRIES=4
# SA_ORCH_PUMPSWAP_PAGE_BONUS=2

