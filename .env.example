# PULLBACK_ALERT_TELEGRAM_CHAT_ID=-1003504887486
# PULLBACK_ALERT_SIGNAL_MODE=rise_then_retrace
# PULLBACK_ALERT_POLL_INTERVAL_MS=20000
# PULLBACK_ALERT_SCAN_MINUTES=90
# PM2: ecosystem.market-pullback-watch.cjs, scripts/pullback-watch-pm2-entry.sh

