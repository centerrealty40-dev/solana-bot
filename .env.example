PAPER_LIQ_WATCH_DISAGREEMENT_PCT=25
# Use discovery quote resolver for liq-watch (Birdeye → DexScreener → PG). Default 1.
PAPER_LIQ_WATCH_DISCOVERY_QUOTE=1

