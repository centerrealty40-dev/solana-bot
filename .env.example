# Live Oscar discovery: min COALESCE(market_cap_usd, fdv_usd) on snapshot row (0 = off). Prod live-oscar: 3000000.
PAPER_DISCOVERY_MIN_MARKET_CAP_USD=0
# Upper bound on pool liquidity for post lane (0 = no cap). Paper Oscar experiment: 200000 with MIN 100000.
PAPER_POST_MAX_LIQ_USD=0
PAPER_POST_MIN_VOL_5M_USD=2500
PAPER_POST_MIN_BUYS_5M=16
PAPER_POST_MIN_SELLS_5M=10
# Прод prod-профили paper + live-oscar: см. ecosystem.config.cjs — типично POST_MIN_AGE 720 мин (12 ч), MAX_AGE 0 (без потолка).
PAPER_POST_MIN_AGE_MIN=720
PAPER_POST_MAX_AGE_MIN=0
PAPER_POST_MIN_BS=1.0

# Pair snapshot: согласованность объёма 5m vs 1h (те же строки raydium/meteora/orca/moonshot/pumpswap).
# Откат поведения до legacy: PAPER_VOL_5M_1H_GUARD_ENABLED=0
PAPER_VOL_5M_1H_GUARD_ENABLED=0
# Минимум volume_1h (USD) при включённом guard
PAPER_VOL_1H_MIN_USD=60000
# Отказ, если volume_5m > (volume_1h/12) * mult ( типичный wash: огромный 5m при «плоском» часе )
PAPER_VOL_5M_SPIKE_MAX_MULT=7

# Global gate
PAPER_MIN_TOKEN_AGE_MIN=0
PAPER_MIN_HOLDER_COUNT=0

# Dip detector
PAPER_DIP_LOOKBACK_MIN=60
# Optional CSV of extra lookbacks (minutes). OR-gate: dip satisfied if any window passes (same min/max drop + impulse). Empty → only PAPER_DIP_LOOKBACK_MIN.
# Example for 2h + 6h + 12h: PAPER_DIP_LOOKBACK_WINDOWS_MIN=120,360,720
PAPER_DIP_LOOKBACK_WINDOWS_MIN=
PAPER_DIP_MIN_DROP_PCT=-12
PAPER_DIP_MAX_DROP_PCT=-45
PAPER_DIP_MIN_IMPULSE_PCT=20
PAPER_DIP_MIN_AGE_MIN=25
PAPER_DIP_COOLDOWN_MIN=30
PAPER_DIP_COOLDOWN_MIN_SCALP=20
# Rolling-flush entry veto (anti «затухающая горка» / падающий нож). Блокирует вход, когда монета —
# падающий нож: по какому-то окну цена ниже хая окна на >= MIN_DUMP% (и не больше MAX_DUMP% — совсем
# мёртвые отдаём другим гвардам) И цена ещё в пределах NEAR_LOW% от LOW окна (не отскочила = на дне).
# Стабилизировавшийся/отскочивший дип проходит. Окна короче dip-lookback. Калибровка на DEXBULL
# (куплен 2026-07-10 16:22 на свежем 30м/60м-дне, −17%/−21% от хая без отскока → −99%): за 10–15м
# просадка была всего ~4%, поэтому дефолт включает 30м/60м. Включать на LERA: *_ENABLED=true
PAPER_DIP_ROLLING_FLUSH_VETO_ENABLED=false
PAPER_DIP_ROLLING_FLUSH_VETO_WINDOWS_MIN=15,30,60
PAPER_DIP_ROLLING_FLUSH_VETO_MIN_DUMP_PCT=10
PAPER_DIP_ROLLING_FLUSH_VETO_MAX_DUMP_PCT=45
PAPER_DIP_ROLLING_FLUSH_VETO_NEAR_LOW_PCT=4
# Пауза повторного входа после убыточного закрытия по тому же mint.
# PAPER_DIP_LOSS_EXIT_COOLDOWN_ENABLED=true (default в коде)
# Пауза повторного входа в тот же mint после **любого** полного close (не только убыток).
# Если PAPER_DIP_LOSS_EXIT_COOLDOWN_MINUTES>0 — используются минуты (приоритет над часами).
# PAPER_DIP_LOSS_EXIT_COOLDOWN_MINUTES=30
# PAPER_DIP_LOSS_EXIT_COOLDOWN_HOURS=0
#
# Hybrid re-entry fork (live-oscar): −N% dip OR +M% breakout → standard dip eval.
# LIVE_REENTRY_MIN_DROP_FROM_LAST_EXIT_PCT=10
# PAPER_REENTRY_DIP_BELOW_EXIT_PCT=10
# PAPER_REENTRY_MIN_DIP_BELOW_EXIT_PCT=10
# LIVE_REENTRY_BREAKOUT_ABOVE_EXIT_PCT=20
# PAPER_REENTRY_ABORT_DIP_WAIT_ABOVE_EXIT_PCT=20
# PAPER_REENTRY_BREAKOUT_ABOVE_EXIT_PCT=20
# LIVE_REENTRY_MAX_WAIT_MINUTES=240


# Whale analysis (default OFF; вкл при запуске Oscar/Dno в W6.5)
PAPER_DIP_WHALE_ANALYSIS_ENABLED=0
PAPER_DIP_REQUIRE_WHALE_TRIGGER=0
PAPER_DIP_LARGE_SELL_USD=3000
PAPER_DIP_RECENT_LOOKBACK_MIN=10
PAPER_DIP_CAPITULATION_PCT=0.7
PAPER_DIP_GROUP_SELL_USD=5000
PAPER_DIP_GROUP_MIN_SELLERS=2
PAPER_DIP_GROUP_DUMP_PCT=0.4
PAPER_DIP_BLOCK_CREATOR_DUMP=true
PAPER_DIP_CREATOR_DUMP_LOOKBACK_MIN=20
PAPER_DIP_CREATOR_DUMP_MIN_PCT=0.05
PAPER_DIP_CREATOR_DUMP_MAX_PCT=0.6
PAPER_DIP_DCA_PRED_MIN_SELLS_24H=4
PAPER_DIP_DCA_PRED_MIN_INTERVAL_MIN=30
PAPER_DIP_DCA_PRED_MIN_CHUNK_USD=3000
PAPER_DIP_DCA_AGGR_MIN_SELLS_24H=6
PAPER_DIP_DCA_AGGR_MAX_INTERVAL_MIN=15

# Legacy launchpad filters (used only when PAPER_ENABLE_LAUNCHPAD_LANE=true; W6.3b stub returns [])
PAPER_MIN_UNIQUE_BUYERS=20
PAPER_MIN_BUY_SOL=5
PAPER_MIN_BUY_SELL_RATIO=1.5
PAPER_MAX_TOP_BUYER_SHARE=0.35
PAPER_MIN_BC_PROGRESS=0.25
PAPER_MAX_BC_PROGRESS=0.95
PAPER_DECISION_AGE_MIN=7
PAPER_DECISION_AGE_MAX_MIN=12
PAPER_WINDOW_START_MIN=2
PAPER_BC_GRADUATION_SOL=85

# ============================================================
# W6.3c — paper-trader executor (exits / DCA / TP-ladder / followup)
# ============================================================
PAPER_TP_X=5.0
PAPER_SL_X=0
PAPER_TRAIL_DROP=0.5
PAPER_TRAIL_TRIGGER_X=1.3
# peak = трейл от пика после trailTriggerX; ladder_retrace = закрыть остаток при откате PnL до предыдущей ступени TP-ladder
PAPER_TRAIL_MODE=peak
PAPER_TIMEOUT_HOURS=12

# Live Oscar only (PAPER_STRATEGY_ID=live-oscar): after ≥1 partial TP_LADDER, if price returns to avg (xAvg≤1), sell this fraction of remainder once. Off by default; prod sets in ecosystem live-oscar.
PAPER_LIVE_OSCAR_BREAKEVEN_TRIM_AFTER_FIRST_TP_ENABLED=0
PAPER_LIVE_OSCAR_BREAKEVEN_TRIM_FRACTION=0.5
# Wave B (wave_b_v1): after +2.5%/+5% TP rungs, one insurance peel at breakeven rollback.
PAPER_LIVE_OSCAR_WAVE_B_BREAKEVEN_INSURANCE_ENABLED=0
PAPER_LIVE_OSCAR_WAVE_B_BREAKEVEN_INSURANCE_FRACTION=0.5
PAPER_LIVE_OSCAR_WAVE_B_BREAKEVEN_INSURANCE_PNL_FRAC=0
# half8_runner: pre-arm (+7.5%) without +8% TP — partial @ +5% vs avg, full exit on pullback @ +2.5%
PAPER_LIVE_OSCAR_WAVE_B_PRE_ARM_NO_HALF8_LADDER_ENABLED=1
PAPER_LIVE_OSCAR_WAVE_B_PRE_ARM_NO_HALF8_PARTIAL_PNL_FRAC=0.05
PAPER_LIVE_OSCAR_WAVE_B_PRE_ARM_NO_HALF8_PULLBACK_PNL_FRAC=0.025
PAPER_LIVE_OSCAR_WAVE_B_PRE_ARM_NO_HALF8_PARTIAL_FRACTION=0.5
# Live Oscar prod tier (mcap ≥ $3M) staged entry split — SSOT: ecosystem.config.cjs live-oscar block.
# Prod: 3×$1000 @ 10s (+3/−5% corridor); staged avg −10% $1000 + −20% $1000; max $5000.
# PAPER_LIVE_STAGED_ENTRY_ENTRY_SPLIT_LEG_USD=1000
# PAPER_LIVE_STAGED_ENTRY_ENTRY_SPLIT_LEG2_USD=1000
# PAPER_LIVE_STAGED_ENTRY_ENTRY_SPLIT_LEG3_USD=1000
# PAPER_LIVE_STAGED_ENTRY_ENTRY_SPLIT_LEG4_USD=0
# PAPER_LIVE_STAGED_ENTRY_ENTRY_SPLIT_LEG5_USD=0
# Solo DexScreener → PG refresh while entry-split legs 2–8 pending (default ON, 45s cooldown, 30s ts bucket).
# PAPER_LIVE_PENDING_LEG_PG_REFRESH_ENABLED=1
# PAPER_LIVE_PENDING_LEG_PG_REFRESH_COOLDOWN_MS=45000
# PAPER_LIVE_PENDING_LEG_PG_REFRESH_BUCKET_SEC=30
# PAPER_LIVE_STAGED_ENTRY_SECOND_LEG_USD=1000
# PAPER_LIVE_STAGED_ENTRY_THIRD_LEG_USD=1000
# PAPER_LIVE_OSCAR_PROD_MCAP_MAX_3_12_USD=5000
# PAPER_LIVE_OSCAR_PROD_MCAP_MAX_12_PLUS_USD=5000
# PAPER_LIVE_OSCAR_PROD_MCAP_VOL_1H_MIN_USD=100000
# Wave B half8_runner E+2: signal −10% before +8% → 50% @ +5% vs avg (default ON for live-oscar).
PAPER_LIVE_OSCAR_DIP10_FIRST_TP5_ENABLED=1
PAPER_LIVE_OSCAR_DIP10_FIRST_TP5_PARTIAL_PNL_FRAC=0.05
PAPER_LIVE_OSCAR_DIP10_FIRST_TP5_PARTIAL_FRACTION=0.5
PAPER_LIVE_OSCAR_DIP10_FIRST_TP5_SIGNAL_DROP_PCT=10
# Live Oscar wave B: new opens only (legacy opens pin prod grid on restore). 0=off.
PAPER_LIVE_OSCAR_EXIT_POLICY_WAVE_B=0
PAPER_LIVE_OSCAR_EXIT_POLICY_WAVE_B_TRAIL_SELL_FRACTION=0.30

# DCA: triggerPct(int %):addFraction, csv. Empty = off.
PAPER_DCA_LEVELS=
PAPER_DCA_KILLSTOP=0

# TP ladder: pnlFrac:sellFracOfRemaining, csv. Empty = off.
PAPER_TP_LADDER=

# TP grid (Paper Oscar-style): PnL step vs avg as fraction (0.05 = +5% each rung); sell fraction of current remainder.
# When PAPER_TP_GRID_STEP_PNL > 0, discrete PAPER_TP_LADDER is ignored at runtime.
PAPER_TP_GRID_STEP_PNL=0
PAPER_TP_GRID_SELL_FRACTION=0.2
# После первой ступени TP-grid: порог retrace в долях PnL к средней (0.025 = +2.5%); 0 = прежнее поведение (к 0%).
PAPER_TP_GRID_FIRST_RUNG_RETRACE_MIN_PNL=0

PAPER_FOLLOWUP_OFFSETS_MIN=30,60,120
PAPER_FOLLOWUP_TICK_MS=30000

PAPER_CONTEXT_SWAPS=true
PAPER_CONTEXT_SWAPS_LIMIT=5
PAPER_PRE_ENTRY_DYNAMICS=true
PAPER_PEAK_LOG_STEP_PCT=1
PAPER_STATS_INTERVAL_MS=300000

# ------------------------------------------------------------
