# --- Wallet Intel policy (W6.11) → wallet_intel_decisions / wallet_intel_runs ---
# WALLET_INTEL_RULE_SET_VERSION= — если пусто, берётся semver из docs/strategy/release/VERSION
WALLET_INTEL_POLICY_LIMIT=20000
WALLET_INTEL_ENTITY_LOOKBACK_HOURS=168
WALLET_INTEL_SCAM_BLOCK_MIN_SCORE=55
# WALLET_INTEL_SCAM_BLOCK_STATUSES=confirmed,needs_evidence
WALLET_INTEL_BOT_PRIMARY_SUPPRESSES_SMART=1
WALLET_INTEL_REQUIRE_SWAP_COVERAGE=0
WALLET_INTEL_EARLY_BUYERS_K=1000
WALLET_INTEL_T_EARLY_MINUTES=45
# WALLET_INTEL_RUN_TAGGER=0
# WALLET_INTEL_RUN_BOT_BUCKET=0 — в wallet-intel-pipeline: шаг intel-bot-bucket перед scam-farm
# WALLET_INTEL_TAGGER_LOOKBACK_HOURS=168
#
# W6.10 intel-bot-bucket (`npm run intel:bot-bucket`)
# BOT_BUCKET_ENABLED=0
# BOT_BUCKET_DRY_RUN=1 — по умолчанию в коде true; для прод-записи выставить 0 (cron задаёт явно)
# BOT_RULE_SET_VERSION=2026-05-06
# BOT_LAYER_B_SINCE_HOURS=168 — на VPS в detective-cron задано 168 ч: при узком 24 ч окне мало on-chain строк в `swaps`, слой B даёт 0 кандидатов.
# BOT_BUCKET_MAX_WALLETS_PER_RULE=4000
# BOT_BUCKET_STATEMENT_TIMEOUT_MS=240000
# BOT_UMBRELLA_INCLUDE_SNIPER=0
# BOT_UMBRELLA_MIN_TRIGGER_CONFIDENCE=1
# BOT_UMBRELLA_CONFIDENCE_FLOOR=80
# BOT_UMBRELLA_CONFIDENCE_CAP=95
# BOT_RULE_SWAP_BURST_OFF=0 / BOT_SWAP_COUNT_24H_MIN / BOT_MEDIAN_GAP_SEC_MAX
# BOT_RULE_MANY_MINTS_OFF=0 / BOT_DISTINCT_MINTS_MIN / BOT_AVG_TRADE_USD_MAX / BOT_MANY_MINTS_SWAP_MIN
# BOT_RULE_FANOUT_OFF=0 / BOT_FANOUT_TARGETS_MIN / BOT_FANOUT_MIN_SOL_PER_LEG
#
# Таблица `swaps` (важно для bot-bucket и политик):
# - Писатели только pump.fun-декод: `sa-parser` (стрим, если процесс запущен), `wallet_backfill`, `sigseed`.
# - Raydium/Meteora/Orca коллекторы в ecosystem — это отдельные снимки, не заполняют `swaps`.
# - Если PM2 без стрима/parser — основной объём `sa-parser` замирает; свежие строки идут из backfill/sigseed (узкая полоса).
# - Диагностика: `psql … -f scripts/diag/swaps-pipeline-diagnostics.sql`
# WALLET_INTEL_MINT_CHECK_MATERIALIZE=1 — при mint-check дописывать решения для покупателей без строки

# --- QuickNode billing (qn-client W7.1 + sa-parser-style reserve) ---
QUICKNODE_MONTHLY_CREDIT_BUDGET=80000000
QUICKNODE_DAILY_CREDIT_BUDGET=3000000
# 0 = only meter + Telegram; block only with QUICKNODE_BUDGET_BLOCK=1 + QUICKNODE_DAILY_ENFORCE=1.
QUICKNODE_DAILY_ENFORCE=0
# Opt-in hard stop on local daily/hourly/provider caps (default off — live bots must not stall).
# QUICKNODE_BUDGET_BLOCK=1
# Hourly cap (UTC hour). 0 or unset = disabled.
QUICKNODE_HOURLY_CREDIT_BUDGET=0
QUICKNODE_CREDITS_PER_SOLANA_RPC=30
# Telegram из quicknode-usage-loop (дашборд):
#   - `QUICKNODE_HOURLY_REMAINING_TELEGRAM=1` — ежечасно `[ALERT][quicknode-balance]` (биллинг-период + скользящие окна).
#   - `QUICKNODE_HOURLY_RECENT_MINUTES_LIST=10,30,60` — какие окна выводить (Admin API).
#   - `QUICKNODE_HOURLY_APPEND_OSCAR_HEALTH=0` — не добавлять в то же сообщение строку Oscar discovery (по умолчанию вкл.: читает `data/live-discovery-health.json` от live-oscar).
#   - Live-oscar пишет снимок: `LIVE_DISCOVERY_HEALTH_SNAPSHOT_PATH` (опц.), окно скользящее `LIVE_DISCOVERY_HEALTH_WINDOW_MS` (дефолт 30 мин).
#   - `QUICKNODE_USAGE_TELEGRAM=0` и milestones — отключены, чтобы не дублировать.
# QUICKNODE_USAGE_TELEGRAM=0
# QUICKNODE_HOURLY_REMAINING_TELEGRAM=1
# QUICKNODE_HOURLY_RECENT_MINUTES_LIST=10,30,60
# QUICKNODE_BILLING_MILESTONES=0
# QUICKNODE_USAGE_PATH=data/quicknode-usage.json
# Per-feature monthly sub-budgets (rolling UTC month). `QN_FEATURE_BUDGET_DISABLED=1` or any `QN_FEATURE_BUDGET_*=0` → no cap.
# QN_FEATURE_BUDGET_DISABLED=0
QN_FEATURE_BUDGET_SAFETY=1000000
QN_FEATURE_BUDGET_PRI_FEE=2000000
QN_FEATURE_BUDGET_PRICE_VERIFY=4000000
QN_FEATURE_BUDGET_SIM=6000000
QN_FEATURE_BUDGET_LIQ_WATCH=12000000
# W7.6 live SPL holders resolver (papertrader)
QN_FEATURE_BUDGET_HOLDERS=10000000
# QN_FEATURE_USAGE_PATH=data/qn-feature-usage.json
# Provider daily cache (optional; sa-stream off): QUICKNODE_DAILY_ENFORCE_PROVIDER=0

# --- Solana HTTPS RPC: QuickNode (primary) + Helius (fallback) ---
# Primary chain for live/paper `qnCall` and sa-stream/sa-parser boot (QuickNode stays first):
#   SA_RPC_HTTP_URL → QUICKNODE_HTTP_URL → SOLANA_RPC_HTTP_URL → ALCHEMY_HTTP_URL
# Helius — запасной вариант, не заменяет QuickNode в .env:
#   - `HELIUS_RPC_URL` или `HELIUS_API_KEY` (собирается https://mainnet.helius-rpc.com/?api-key=…)
#   - `SOLANA_RPC_HELIUS_FALLBACK_ENABLED=1` (дефолт): при блоке локального QN-бюджета / feature-cap
#     `qn-client` повторяет тот же JSON-RPC на Helius без списания quicknode-usage (см. resolve-solana-rpc-url.ts).
#   - `SOLANA_RPC_HELIUS_FALLBACK_ENABLED=0` — только QuickNode, без автопереключения.
#   - `SOLANA_RPC_HELIUS_PREFER=1` (live-oscar): send/simulate/confirm/getBalance идут на Helius;
#     `SA_RPC_HTTP_URL` остаётся QuickNode для discovery/holders. Иначе Helius не тратит кредиты, пока QN meter не блокирует.
# Секрет Helius — только в VPS `.env`, не коммитить.
# HELIUS_API_KEY=
# HELIUS_RPC_URL=
# SOLANA_RPC_HELIUS_FALLBACK_ENABLED=1

