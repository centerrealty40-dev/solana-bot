# ===== W6.1 — DEX collectors =====
# All collectors use sane defaults; override only if needed.

# Raydium / Meteora / Orca / Moonshot collectors (DexScreener + GeckoTerminal):
RAYDIUM_COLLECTOR_INTERVAL_MS=60000
METEORA_COLLECTOR_INTERVAL_MS=60000
ORCA_COLLECTOR_INTERVAL_MS=60000
MOONSHOT_COLLECTOR_INTERVAL_MS=60000

# DexScreener shared gate + quote cache (Oscar VPS — live-oscar + collectors share one egress IP).
# DEXSCREENER_GLOBAL_RATE_LIMIT=1 — cross-process slot scheduler (default ON in PM2)
# DEXSCREENER_GLOBAL_MAX_RPM=42 — shared requests/min across collectors + live-oscar
# DEXSCREENER_GLOBAL_GATE_PATH=data/dexscreener-api-gate.json
# DEX_QUOTE_CACHE_ENABLED=1 — file cache for /latest/dex/tokens/{mint} (default ON in PM2)
# DEX_QUOTE_CACHE_TTL_MS=20000 — cross-process quote TTL (12s–60s)
# DEX_QUOTE_CACHE_PATH=data/dexscreener-quote-cache.json
# Lera (separate VPS 72.62.152.201) does NOT read Oscar cache — needs HTTP/shared store for cross-host dedup.

# Birdeye Data API (Lite+): discovery eval + MTM + collector enrich (default OFF).
# BIRDEYE_API_KEY=...  — from https://bds.birdeye.so/ (VPS `.env` only, never commit)
# BIRDEYE_PRIMARY_ENABLED=1 — Birdeye → DexScreener → PG at discovery eval + MTM baseline
# BIRDEYE_COLLECTOR_ENABLED=1 — enrich open/pin mints in pumpswap/raydium/meteora collectors
# BIRDEYE_USE_BATCH=1 — try Business-tier market-data/multiple (Lite: 0, per-mint only)
# BIRDEYE_MARKET_TTL_MS=12000 — in-process cache per mint
# BIRDEYE_MAX_STALE_MS=15000 — freshness gate for accepting Birdeye over PG
# BIRDEYE_COVERAGE_GAP_MIN_MS=300000 — journal `birdeye_coverage_gap` when PG older and REST miss
# BIRDEYE_TELEGRAM_ENABLED=1 — ALERT on Lite tier limit (429/CU) and coverage gaps
# BIRDEYE_TELEGRAM_TIER_COOLDOWN_MS=1800000
# BIRDEYE_TELEGRAM_COVERAGE_GAP_COOLDOWN_MS=1800000

# Jupiter route watcher:
JUPITER_QUOTE_API_URL=https://api.jup.ag/swap/v1/quote
# Jupiter Developer Platform ($25/mo, 10 RPS) — set after subscribing at portal.jup.ag
# JUPITER_API_KEY=jup_...  — required for Developer tier; PM2 reads from `.env` (see ecosystem.config.cjs)
# JUPITER_DEVELOPER_TIER=1 — marker for tuned delays/concurrency (ecosystem sets for sa-jupiter + live-oscar)
JUPITER_WATCHER_INTERVAL_MS=60000
JUPITER_WATCHER_LOOKBACK_HOURS=2
JUPITER_WATCHER_MAX_MINTS=20
JUPITER_WATCHER_QUOTE_IN_USD=25
JUPITER_WATCHER_SLIPPAGE_BPS=300
# Developer 10 RPS: 3 parallel workers × 500 ms throttle ≈ 6 RPS (headroom for live-oscar)
# JUPITER_WATCHER_REQUEST_DELAY_MS=500
# JUPITER_WATCHER_QUOTE_CONCURRENCY=3
# Free tier (no key): use 1000–1250 ms delay, concurrency 1
# CRITICAL: must be '0' until W6.7 (rpc_tasks table not created yet).
JUPITER_WATCHER_ENQUEUE_RPC=0

# Direct-LP detector:
DIRECT_LP_DETECTOR_INTERVAL_MS=60000
DIRECT_LP_FRESH_LOOKBACK_MINUTES=10
DIRECT_LP_HISTORY_LOOKBACK_HOURS=168
DIRECT_LP_MIN_LIQUIDITY_USD=0
# CRITICAL: must be '0' until W6.7 (rpc_tasks table not created yet).
DIRECT_LP_ENQUEUE_RPC=0

# ============================================================
# W6.7 — Gecko new_pools → Raydium → RPC wallet seed (sa-grws-collector)
# Normative: docs/Smart Lottery V2/W6.7_gecko_raydium_wallet_seed_collector_local.md
# Run: npm run sa-grws-collector   (append --daemon for interval; SA_GRWS_INTERVAL_MS default 10 min)
