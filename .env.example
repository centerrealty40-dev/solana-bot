PAPER2_DIR=/opt/solana-alpha/data/paper2
# Первая колонка `/papertrader2`: журнал live-oscar (не сканируется из PAPER2_DIR).
# Дефолт в коде: resolve(PAPER2_DIR/../live/pt1-oscar-live.jsonl)
# DASHBOARD_LIVE_OSCAR_JSONL=/opt/solana-alpha/data/live/pt1-oscar-live.jsonl
