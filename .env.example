# Окно (часы) для Coverage mints и для блока «Оркестратор кошельков» в hourly Telegram (см. W6.8 §10 п.4).
# Hourly Telegram: по умолчанию выкл.; для сводок (в т.ч. Health · pumpswap snapshots STALE): TELEGRAM_HOURLY_REPORT_ENABLED=1
# TELEGRAM_HOURLY_REPORT_ENABLED=1

# Snapshot / collector observability (1.11.220)
# SNAPSHOT_FRESHNESS_MAX_AGE_SEC=600
# SNAPSHOT_FRESHNESS_POLL_MS=300000

