# === solana-alpha v2 (post-W2 slim) ===

# --- Database ---
# Preferred new name (matches ops docs). Legacy alias: DATABASE_URL (still supported in code).
SA_PG_DSN=postgresql://salpha:CHANGE_ME@localhost:5432/solana_alpha

# --- Redis (required by src/core/config.ts when any code imports DB/logger chain) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Solana RPC (paid endpoint, used by scam-farm-detective и future sa-stream) ---
SA_RPC_URL=https://api.mainnet-beta.solana.com
SA_RPC_FALLBACK_URLS=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Три Telegram-канала (prod) — не смешивать ---
# Advice / health / ALERT (live-oscar pulse, collector, snapshot stale, pg coverage): -1003878024799
# Pumps (market-spike-telegram-watch, tier/minute windows): -1003633176769
# Dips (pullback + retrace, блоки 1–2–3): -1003504887486
# Переопределите в `.env`; дефолты в ecosystem.config.cjs.

# --- Market spike watch (отдельный бот; НЕ трогает Live Oscar TELEGRAM_* rate-limit) ---
# SPIKE_ALERT_TELEGRAM_BOT_TOKEN=
# SPIKE_ALERT_TELEGRAM_CHAT_ID=-1003633176769
# Опрос PG каждые N мс (рекомендуется 15000–30000); 0 = один проход и exit под cron
# SPIKE_ALERT_POLL_INTERVAL_MS=20000
# При опросе: не дублировать то же событие в Telegram чаще чем раз в N мс
# SPIKE_ALERT_POLL_SEND_DEDUPE_MS=60000
# SPIKE_ALERT_MINT_COOLDOWN_MINUTES=5 — базовая пауза по mint; эскалация SPIKE_ALERT_ESCALATE_* может слать [UPDATE] внутри окна
# SPIKE_ALERT_SCAN_MINUTES=60
# SPIKE_ALERT_ROLLING_MINUTES=3 — нижняя граница окна накопления (мин); 0 = выкл. накопление
# SPIKE_ALERT_ROLLING_MAX_MINUTES=10 — верхняя граница; сканируются все целые W от MIN до MAX
# Устар.: LOOKBACK_SEC / WINDOW_MIN — только для совместимости env в скрипте
# SPIKE_ALERT_LOOKBACK_SEC=60
# SPIKE_ALERT_WINDOW_MIN=30
# Плоские пороги (когда SPIKE_ALERT_TIERED_BY_MCAP=0):
# SPIKE_ALERT_THRESHOLD_PCT=8 — дефолт для pump consecutive, если не задан SPIKE_ALERT_THRESHOLD_PUMP_CONSEC_PCT
# SPIKE_ALERT_THRESHOLD_PUMP_CONSEC_PCT=8 — соседние минутные бары, рост
# SPIKE_ALERT_THRESHOLD_DUMP_CONSEC_PCT=8 — соседние минутные бары, пролив
# SPIKE_ALERT_THRESHOLD_ROLLING_PCT=10 — накопление: хотя бы одно окно W мин (MIN…MAX)
# SPIKE_ALERT_MIN_HOLDERS=1000
# SPIKE_ALERT_HOLDER_NULL_SOFT=1 — если holder_count NULL в tokens, не отсекать mint только из-за holders
# SPIKE_ALERT_MIN_AGE_HOURS=3
# SPIKE_ALERT_MIN_VOL_5M_USD=0
# SPIKE_ALERT_MAX_ROWS_PER_TABLE=800 — лимит mint на таблицу DEX; берём с самым свежим ts снимка в окне пола
# SPIKE_ALERT_MIN_LIQ_USD=0
# SPIKE_ALERT_MIN_MARKET_CAP_USD=2000000 — COALESCE(s.market_cap_usd, s.fdv_usd, t.fdv_usd); 0 = выкл.
# SPIKE_ALERT_DRY_RUN=0
# Только «свежие» события: новый бар скачка не старше N минут (иначе игнор в окне скана)
# SPIKE_ALERT_MAX_NEWER_BAR_AGE_MINUTES=20
# Если liq_usd в снимке ниже порога — отсечь гигантские |Δ%| (шум тонкого пула в PG)
# SPIKE_ALERT_LOW_LIQ_GLITCH_THRESHOLD_USD=5000
# SPIKE_ALERT_LOW_LIQ_MAX_ABS_PCT=55
# SPIKE_ALERT_DISPLAY_TZ=Europe/Moscow
# Доля отката следующей минутой при одноминутном выбросе (0 = выкл.)
# SPIKE_ALERT_GLITCH_NEXT_BAR_RETRACE_MIN=0.55
# Перекрёстная проверка: при ref mcap/fdv ≥ REF_MIN ликвидность снимка должна быть ≥ ratio × ref (отсекает битые строки PG)
# SPIKE_ALERT_LIQ_MCAP_SANITY=1
# SPIKE_ALERT_LIQ_MCAP_REF_MIN_USD=2000000
# SPIKE_ALERT_MIN_LIQ_TO_REF_MCAP_RATIO=0.002
# Если в обоих минутных барах есть mcap_usd — |Δ% mcap − Δ% price| не больше порога
# SPIKE_ALERT_MC_PRICE_MAX_DIVERGENCE_PCT=8
# SPIKE_ALERT_DEXSCREENER_META=1 — symbol/name из Dexscreener, если в tokens пусто
# SPIKE_ALERT_UPSERT_TOKEN_META=1 — записать найденное в tokens (не затирает уже заполненные поля)
# SPIKE_ALERT_DEXSCREENER_CHUNK=20 — mint в одном запросе к API
# SPIKE_ALERT_DEXSCREENER_CACHE_TTL_MS=86400000 — TTL кэша метаданных в памяти процесса
#
# Tier по market cap (SPIKE_ALERT_TIERED_BY_MCAP=1 по умолчанию в spike-watch PM2):
# tier3 ≥$7M: dump consec/rolling 8%/10%; tier2 ≥$3M: 11%/12%; tier1 ≥$1.5M: 14%/15%; pump ≥30%; < $1.5M — отброс
# SPIKE_ALERT_TIERED_BY_MCAP=1
# SPIKE_ALERT_PUMP_MIN_PCT=30
# SPIKE_ALERT_DUMP_TIER1_MCAP_USD=1500000
# SPIKE_ALERT_DUMP_TIER1_MIN_PCT=14
# SPIKE_ALERT_DUMP_TIER1_MIN_PCT_ROLLING=15
# SPIKE_ALERT_DUMP_TIER2_MCAP_USD=3000000
# SPIKE_ALERT_DUMP_TIER2_MIN_PCT=11
# SPIKE_ALERT_DUMP_TIER2_MIN_PCT_ROLLING=12
# SPIKE_ALERT_DUMP_TIER3_MCAP_USD=7000000
# SPIKE_ALERT_DUMP_TIER3_MIN_PCT=8
# SPIKE_ALERT_DUMP_TIER3_MIN_PCT_ROLLING=10
# SPIKE_ALERT_LOG_MISS_BY_FILTER=1
#
# Эскалация [UPDATE] внутри mint-cooldown при усилении пролива
# SPIKE_ALERT_ESCALATE_ENABLED=1 — follow-up «Вот уже N%» (10→15→20…) внутри mint cooldown
# SPIKE_ALERT_ESCALATE_DELTA_PCT=5
# SPIKE_ALERT_ESCALATE_MIN_GAP_SEC=60
# SPIKE_ALERT_ESCALATE_MAX_PER_MINT=8
# SPIKE_ALERT_ESCALATE_TIER_CHANGE_FORCES_UPDATE=1
#
# Аудит в PG (таблица market_spike_events, миграция 0023; при старте также CREATE IF NOT EXISTS)
# SPIKE_ALERT_AUDIT_DB_ENABLED=1
# SPIKE_ALERT_AUDIT_LOG_SKIPS=0
#
# Диагностика (без Telegram): npm run market-spike-telegram-watch -- --diagnose-mint <mint> [--at 2026-05-14T13:37:00Z]

# --- Pump-then-retrace watch (отдельный бот/канал; НЕ SPIKE_ALERT_* и не TELEGRAM_* Live Oscar) ---
# Паттерн: рост от локального дна ≥ RETRACE_ALERT_MIN_PUMP_PCT%, затем откат от пика ≥ RETRACE_ALERT_MIN_RETRACE_FROM_PEAK_PCT%;
# mcap в отборе latest ≥ RETRACE_ALERT_MIN_MCAP_USD (COALESCE как в spike).
# RETRACE_ALERT_TELEGRAM_BOT_TOKEN=
# RETRACE_ALERT_TELEGRAM_CHAT_ID=-1003504887486
# RETRACE_ALERT_POLL_INTERVAL_MS=20000
# RETRACE_ALERT_POLL_SEND_DEDUPE_MS=120000
# RETRACE_ALERT_MINT_COOLDOWN_MINUTES=30
# RETRACE_ALERT_SCAN_MINUTES=120
# RETRACE_ALERT_MIN_MCAP_USD=1000000
# RETRACE_ALERT_MIN_PUMP_PCT=6
# RETRACE_ALERT_MIN_RETRACE_FROM_PEAK_PCT=10
# RETRACE_ALERT_MAX_EVENT_AGE_MINUTES=15
# RETRACE_ALERT_MAX_ROWS_PER_TABLE=800
# RETRACE_ALERT_MIN_AGE_HOURS=3
# RETRACE_ALERT_MIN_HOLDERS=0
# RETRACE_ALERT_HOLDER_NULL_SOFT=1
# RETRACE_ALERT_DISPLAY_TZ=Europe/Moscow
# RETRACE_ALERT_DRY_RUN=0
# PM2: см. ecosystem.retrace-alert-watch.cjs и scripts/retrace-alert-pm2-entry.sh

# --- Market pullback watch (второй канал: локальный хай / rise_then_retrace; блоки 1–2–3) ---
