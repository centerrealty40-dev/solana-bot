HOURLY_COVERAGE_HOURS=1
# Порог STALE для строки Health · swaps по max(created_at), мин (ингест backfill/sigseed; не near-tip block_time)
# HOURLY_HEALTH_SWAPS_INGEST_MAX_MIN=30
HOURLY_TOP_N=4
POSITION_USD=100
# Журнал live (по умолчанию LIVE_TRADES_PATH или data/live/pt1-oscar-live.jsonl)
# HOURLY_LIVE_JSONL=/opt/solana-alpha/data/live/pt1-oscar-live.jsonl
# Paper Oscar JSONL для счётчика Eval (pass за час)
# HOURLY_OSCAR_EVAL_JSONL=/opt/solana-alpha/data/paper2/pt1-oscar.jsonl
# HOURLY_LIVE_STRATEGY_ID=live-oscar
# Баланс кошелька в hourly: RPC и pubkey (fallback LIVE_WALLET_PUBKEY)
# HOURLY_RPC_URL= — иначе берётся SA_RPC_HTTP_URL / SA_RPC_URL (на VPS обычно задан SA_RPC_HTTP_URL)
# HOURLY_WALLET_PUBKEY= — иначе LIVE_WALLET_PUBKEY из этого же .env (нужно для баланса SOL/USDC в hourly Telegram)
# Блок детектива в том же hourly-сообщении (wallet_tags bot / узкие теги / wallet_backfill_queue). Только SQL. Выкл: HOURLY_APPEND_DETECTIVE_INTEL=0
# HOURLY_APPEND_DETECTIVE_INTEL=1
# Сводка MTM shadow (второй Jupiter-probe, JSONL от live-oscar). Выкл: HOURLY_APPEND_MTM_SHADOW=0
# HOURLY_MTM_SHADOW_JSONL=/opt/solana-alpha/data/live/mtm-shadow.jsonl

# post-mortem (on-demand)
PM_WINDOW_HOURS=48

# ============================================================
# W8.0 — live-oscar (Phase 0+: отдельный процесс, см. W8.0_IMPLEMENTATION_PHASES.md)
# Rollback: не поднимать PM2 live-oscar или LIVE_STRATEGY_ENABLED=0.
# LIVE_TRADES_PATH обязан отличаться от журнала paper Oscar (LIVE_PARITY_PAPER_TRADES_PATH / PAPER_TRADES_PATH).
#
# Второй торговый процесс **live-oscar-risky** (мягкие входы, $200): все `LIVE_*` / `PAPER_*` только в блоке PM2
# `live-oscar-risky` в `ecosystem.config.cjs`, отдельный keypair и whitelist — не переопределяйте здесь для двух кошельков сразу.
# ============================================================
LIVE_STRATEGY_ENABLED=0
LIVE_EXECUTION_MODE=dry_run
LIVE_STRATEGY_PROFILE=oscar
LIVE_STRATEGY_ID=live-oscar
LIVE_TRADES_PATH=/opt/solana-alpha/data/live/pt1-oscar-live.jsonl
# Только mint из файла — новый вход в live (после всех гейтов). Нет в списке → skip + Telegram (не ALERT по умолчанию).
# LIVE_MINT_WHITELIST_ENABLED=0
# LIVE_MINT_WHITELIST_PATH=/opt/solana-alpha/data/live/live-oscar-mint-whitelist.txt
# LIVE_MINT_WHITELIST_TELEGRAM_CATEGORY=ADVICE — ADVICE|REPORT|HEALTH|ALERT (ALERT игнорирует TELEGRAM_QUIET_*)
# LIVE_MINT_WHITELIST_NOTIFY_COOLDOWN_MS=300000 — троттлинг per-mint для live_whitelist_miss (дефолт 5 мин); 0 = без лимита
# После N подряд убыточных полных закрытий live по mint из whitelist — удалить строку из файла и Telegram (ALERT по умолчанию).
# LIVE_MINT_WHITELIST_REMOVE_AFTER_CONSEC_LOSSES=2 — 0 = выключить автоудаление
# LIVE_MINT_WHITELIST_DROP_TELEGRAM_CATEGORY=ALERT — ADVICE|REPORT|HEALTH|ALERT
# LIVE_MINT_WHITELIST_LOSS_STREAK_PATH=data/live/live-oscar-whitelist-consec-loss.json — счётчик подряд убытков по mint
# Постоянный запрет на SOL→token (seed из репо + локальный файл на VPS, переживает git reset):
# LIVE_OSCAR_PERMANENT_DENYLIST_LOCAL_PATH=data/live/live-oscar-permanent-denylist.txt
# LIVE_OSCAR_PERMANENT_DENYLIST_SEED_PATH=data/live/live-oscar-permanent-denylist.seed.txt
# LIVE_OSCAR_PERMANENT_DENYLIST_DISABLED=0 — 1 отключает проверку и автодопись (заготовка в коде)
# LIVE_NEGATIVE_TRADE_DENY_ENABLED=0 — не добавлять mint после убыточного close
# LIVE_FIRST_MINT_PROBE_DENY_ON_LOSS_ENABLED=0 — first-probe loss → deny (stub в коде)
#
# Signal lab — отдельный JSONL снимков перед live/simulate buy_open (не гейты, не PnL). Jupiter quote + PG/drift.
# В ecosystem PM2 live-oscar включено накопление (100% sample + alt probe); локально скопируйте при необходимости:
# SIGNAL_LAB_ENABLED=1
# SIGNAL_LAB_SAMPLE_PCT=100
# SIGNAL_LAB_PATH=/opt/solana-alpha/data/live/signal-lab.jsonl
# SIGNAL_LAB_ALT_PROBE_FRACTION=0.55
#
# MTM shadow — второй Jupiter-probe на открытых позициях (трекер), отдельный JSONL; не меняет MTM/решения.
# MTM_SHADOW_ENABLED=1
# MTM_SHADOW_SAMPLE_PCT=100
# MTM_SHADOW_PATH=/opt/solana-alpha/data/live/mtm-shadow.jsonl
# MTM_SHADOW_ALT_FRACTION=0.58
#
# Live tracker (Jupiter MTM): пауза между mint в одном тике; для Pro ~10 RPS можно 50–80. 0 = без паузы.
# LIVE_TRACKER_INTER_MINT_DELAY_MS=80
# Если Jupiter buy-probe выше PG snapshot более чем на N% — MTM на тике по snapshot (анти-призрак). 0 = выкл.
# LIVE_TRACKER_JUPITER_MAX_PREMIUM_OVER_SNAPSHOT_PCT=6
#
# Контроль ошибок Jupiter API по shadow JSONL (npm run jupiter:shadow-watch). Не использует QuickNode.
# Установка cron (user salpha, TELEGRAM из /opt/solana-alpha/.env): sudo bash scripts/cron/install-jupiter-shadow-watch-cron-salpha.sh
# Ручной cron: */10 * * * * cd /opt/solana-alpha && SOLANA_ALPHA_ROOT=/opt/solana-alpha SHADOW_WATCH_TELEGRAM=1 node scripts-tmp/jupiter-shadow-watch.mjs >> data/logs/jupiter-shadow-watch.log 2>&1
# Если TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID заданы, алерты включаются и без SHADOW_WATCH_TELEGRAM; явно выкл: SHADOW_WATCH_TELEGRAM=0
# SHADOW_WATCH_WINDOW_MS=600000
# SHADOW_WATCH_SIGNAL_PATH=/opt/solana-alpha/data/live/signal-lab.jsonl
# SHADOW_WATCH_MTM_PATH=/opt/solana-alpha/data/live/mtm-shadow.jsonl
# SHADOW_WATCH_MIN_EVENTS=5
# SHADOW_WATCH_MAX_ERR_RATIO=0.4
# SHADOW_WATCH_ALERT_COOLDOWN_MS=1800000
#
# Почасовая сводка по Jupiter shadow (npm run jupiter:shadow-hourly): всегда шлёт одно сообщение [REPORT/ALERT][jupiter-shadow]
# Установка cron (user salpha, 0 * * * * UTC): sudo bash scripts/cron/install-jupiter-shadow-hourly-cron-salpha.sh
# JUPITER_SHADOW_HOURLY_WINDOW_MS=3600000
# JUPITER_SHADOW_HOURLY_ALERT_RATIO=0.2
# JUPITER_SHADOW_HOURLY_MIN_EVENTS=5
# JUPITER_SHADOW_HOURLY_FORCE_ALERT=0
# JUPITER_SHADOW_HOURLY_SEND_IF_ZERO_ERRORS=0 — при 1 слать почасовой отчёт и при 0 ошибок (старое поведение); иначе Telegram только если ошибки > 0
# JUPITER_SHADOW_HOURLY_TELEGRAM=0 — по умолчанию в скрипте почасовые сводки в Telegram выключены; =1 включить [REPORT|ALERT][jupiter-shadow]
#
# --- W9.0 — dip_bot intel (`npm run dip-bot-intel:run`, см. deploy/RUNTIME.md, specs/W9.0*) ---
# Якоря: строки `live_position_open` с journal `strategyId` из списка DIP_BOT_ANCHOR_STRATEGY_IDS (CSV), либо **`*` / `all`** / `DIP_BOT_ANCHOR_ANY_STRATEGY=1` — все стратегии.
# Дефолт кода: live-oscar,pt1-oscar — paper-журнал даёт якоря из строк **`kind: open`** и из зеркала **`live_position_open`**.
# Источник JSONL: DIP_BOT_LIVE_JSONL или LIVE_TRADES_PATH или data/live/pt1-oscar-live.jsonl (один файл за прогон).
# Дефолты кода (если переменная не задана): T_PRE_MS=60000, MIN_USD_ONE_EVENT=50, MIN_HITS=3, MAX_ANCHORS_PER_RUN=30.
# Смягчённый прод-профиль (ниже) — для первого выхода из «нулевых наблюдений», когда `swaps` уже есть, но окно/USD жёсткие.
# DIP_BOT_LIVE_JSONL=/opt/solana-alpha/data/paper2/pt1-oscar.jsonl
# DIP_BOT_ANCHOR_STRATEGY_IDS=live-oscar,pt1-oscar
# DIP_BOT_ANCHOR_STRATEGY_IDS=*
# npm run dip-bot-intel:anchor-gaps — mint с buyer_rows=0 (дыры инжеста swaps → sigseed/backfill)
# npm run sigseed:enqueue-mints -- --from-dip-anchor-gaps — поставить эти mint в signatures_seed_queue (шаг перед sigseed:run)
# npm run dip-bot-intel:export-candidates [--csv] [--detail] — список кошельков-кандидатов для ручного разбора
DIP_BOT_T_PRE_MS=180000
DIP_BOT_MIN_USD_ONE_EVENT=15
DIP_BOT_MIN_HITS=2
# DIP_BOT_MAX_ANCHORS_PER_RUN=30
# DIP_BOT_EXCLUDE_WALLET= — иначе часто LIVE_WALLET_PUBKEY (наш кошелёк не считается покупателем-дипботом)
LIVE_HEARTBEAT_INTERVAL_MS=60000
# Telegram HEALTH (live-oscar): near_ready_dip_wait / newcomers → GMGN links; legacy cand/eval gate_skip только при явном включении:
# LIVE_HEARTBEAT_LEGACY_DISC_TELEGRAM=1
# LIVE_HEARTBEAT_LEGACY_DISC_JSONL=1 — те же метрики в JSONL heartbeat
# LIVE_HEARTBEAT_NEAR_READY_MAX_LINES=15 — макс. строк «new_on_horizon» за пульс (1–25)
LIVE_PARITY_PAPER_TRADES_PATH=/opt/solana-alpha/data/paper2/pt1-oscar.jsonl
# Phase 4: загрузить fragment с baseline `PAPER_*` (отдельный файл от канарейки pt1-oscar; см. W8.0-p4 §3.3.1)
# LIVE_INHERIT_ENV_FILE=/opt/solana-alpha/data/env/live-oscar-baseline.env
# На live-oscar держите PAPER_DRY_RUN=0 иначе конвейер входа до гейтов не выполняется.
# W7.4 / W7.4.2: для PM2 `live-oscar` дефолты в ecosystem.config.cjs (pre-entry + pre-exit, пороги как pt1-oscar).
# LIVE_WALLET_SECRET — только при ENABLED=1 и simulate|live (путь к файлу *.keypair.txt или *.keypair.json:
#   одна строка base58 из Phantom, JSON-массив байт Solana CLI, или 64+ чисел через запятую/пробел)
# LIVE_WALLET_PUBKEY= — опционально: ожидаемый публичный адрес; при несовпадении с ключом из файла процесс не стартует.
# Сид-фразу в git/env не класть; восстановите keypair локально и загрузите файл на VPS.
# Опционально: fsync на каждый heartbeat live JSONL (дефолт выкл.)
# LIVE_JSONL_FSYNC_HEARTBEAT=0

# W8.0 Phase 2 — Jupiter API (quote + unsigned swap body)
# Jupiter Developer Platform: $25/mo, **10 RPS** (portal.jup.ag). Free tier ≈ 1 RPS without key.
# JUPITER_API_KEY=jup_... — API key as `x-api-key` on all quote/swap calls; store only in `.env`.
# JUPITER_DEVELOPER_TIER=1 — PM2 marker; ecosystem.config.cjs tunes watcher + live-oscar retries.
# Cross-process rate gate (shared Developer key across PM2 apps): default 8 RPS when key set.
# JUPITER_GLOBAL_MAX_RPS=8
# JUPITER_GLOBAL_GATE_PATH=data/jupiter-api-gate.json
# JUPITER_GLOBAL_RATE_LIMIT=0 — disable cross-process gate.
# Повтор GET quote при 429 (Developer burst 10 RPS): PM2 default 12 попыток, backoff 100 ms (cap 12).
# JUPITER_QUOTE_429_MAX_RETRIES=12
# JUPITER_QUOTE_429_INITIAL_BACKOFF_MS=100
# JUPITER_QUOTE_429_MAX_RETRIES=0 — без повторов (старое поведение на каждый 429).
# Jupiter 429 Telegram (live-oscar): burst off by default; exhaust on real quote/swap failure.
# JUPITER_429_BURST_TELEGRAM=1 — ALERT jupiter-429-burst при ≥N HTTP 429 в окне (retry noise).
# JUPITER_429_EXHAUST_TELEGRAM=0 — выкл. ALERT jupiter-429-exhaust при исчерпании retry.
# RATE_429_REPORT_TELEGRAM=1 — [REPORT] agent_429 каждые 30 мин (PM2 default 0).
# LIVE_JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
# LIVE_JUPITER_SWAP_URL=https://api.jup.ag/swap/v1/swap
# PAPER_PRICE_VERIFY_QUOTE_URL=https://api.jup.ag/swap/v1/quote
# PAPER_JUPITER_SWAP_URL=https://api.jup.ag/swap/v1/swap
# JUPITER_QUOTE_API_URL=https://api.jup.ag/swap/v1/quote
# LIVE_JUPITER_QUOTE_TIMEOUT_MS=5000
# LIVE_JUPITER_SWAP_TIMEOUT_MS=8000
# live-oscar PM2: base slippage 10 bps + sim retry x15 (150 ms); slippage-class bump +10 bps to cap 100 bps
# copy-trader / preset-c: 100 bps base via COPY_TRADER_SLIPPAGE_BPS / LIVE_DEFAULT_SLIPPAGE_BPS
# LIVE_DEFAULT_SLIPPAGE_BPS=10
# LIVE_BUY_SIM_RETRY_ATTEMPTS=15
# LIVE_SELL_SIM_RETRY_ATTEMPTS=15
# LIVE_BUY_SIM_SLIPPAGE_RETRY_ATTEMPTS=8
# LIVE_SELL_SIM_SLIPPAGE_RETRY_ATTEMPTS=12
# Опционально: потолок приоритета Jupiter `/swap/v1/swap` — не раздувать fees; cap 0.0001 SOL + level high:
# LIVE_JUPITER_PRIORITY_MAX_SOL=0.0001
# LIVE_JUPITER_PRIORITY_MAX_LAMPORTS=100000
# LIVE_JUPITER_SWAP_PRIORITY_LEVEL=high — medium | high | veryHigh (live-oscar: high, not veryHigh)
# LIVE_TRACKER_INTER_MINT_DELAY_MS=60 — MTM probe pacing (~16/s burst under 10 RPS with backoff)
# LIVE_QUOTE_MAX_AGE_MS=8000 — по умолчанию в коде 8000 мс, если переменная не задана; 0 = выключить гейт; верхняя граница парсера 600000 (W8.0 §10)
# Одноразовый смок после live_boot (не для прод без контроля лимитов):
# LIVE_PHASE2_JUPITER_SELF_TEST=0
# LIVE_PHASE2_SELF_TEST_MINT=
# LIVE_PHASE2_SELF_TEST_SIZE_USD=1
# LIVE_PHASE2_SOL_USD=150
# LIVE_PHASE2_USER_PUBKEY= — иначе детерминированный placeholder (не для send)

# W8.0 Phase 3 — sign + simulateTransaction (QuickNode via SA_RPC_HTTP_URL; feature sim)
# LIVE_SIM_ENABLED=1
# LIVE_SIM_TIMEOUT_MS=12000
# LIVE_SIM_CREDITS_PER_CALL=30
# LIVE_SIM_REPLACE_RECENT_BLOCKHASH=1
# LIVE_SIM_SIG_VERIFY=0
# Опциональный смок: quote → build → sign → simulate (требует SA_RPC_HTTP_URL, mint, кошелёк):
# LIVE_PHASE3_SIM_SELF_TEST=0
# LIVE_PHASE3_SELF_TEST_MINT=
# LIVE_PHASE3_SELF_TEST_SIZE_USD=1
# LIVE_PHASE3_SOL_USD=150

# W8.0 Phase 5 — §3.3 risk / §3.4 capital (переменная не задана ⇒ проверка выключена; см. CHANGELOG 1.8.0)
# LIVE_MAX_POSITION_USD=
# LIVE_MAX_OPEN_POSITIONS=
# LIVE_KILL_AFTER_CONSEC_FAIL=0
# LIVE_MIN_WALLET_SOL= — мин. нативный SOL (whole) на кошельке; опционально
# LIVE_MIN_WALLET_SOL_EQUITY_USD= — live-only **новые** входы: SOL×USD ≥ N (напр. 22)
# LIVE_BTC_GATE_ENABLED=1 — live-only **новые** входы: блок при просадке BTC (Binance klines в paper pricing)
# LIVE_BTC_GATE_MAX_STALE_MS=900000 — не блокировать, если контекст BTC старше N мс
# LIVE_BTC_BLOCK_1H_DRAWDOWN_PCT=2.5 — блок если ret1h_pct ≤ −N (п.п.)
# LIVE_BTC_BLOCK_4H_DRAWDOWN_PCT=5 — блок если ret4h_pct ≤ −N (п.п.)
# LIVE_BTC_GATE_TELEGRAM_ENABLED=1 — TG в LIVE_MINT_WHITELIST_TELEGRAM_* при блоке/снятии buy_open
# --- Мем-режимный гейт (RCA слива 6–8 июля): broad risk-off по нашей runner-вселенной (*_pair_snapshots) ---
# LIVE_MEM_REGIME_ENABLED=0 — мастер-флаг (default off)
# LIVE_MEM_REGIME_MODE=off — off|shadow|gate; shadow только журналит risk_note, gate блокирует новые buy_open
# LIVE_MEM_REGIME_REFRESH_SEC=60 — фон обновления индекса (вне hot-path)
# LIVE_MEM_REGIME_LOOKBACK_MIN=60 — импульс: latest vs latest ≤ now−lookback
# LIVE_MEM_REGIME_BASELINE_TOL_MIN=20 — запас окна снапшотов для baseline
# LIVE_MEM_REGIME_MIN_RUNNER_V1H_USD=10000 — раннер = пиковый 1h-объём ≥ этого
# LIVE_MEM_REGIME_MIN_RUNNERS=20 — ниже = insufficient data (не блокирует)
# LIVE_MEM_REGIME_BREADTH_RED_PCT=58 — сигнал: доля красных раннеров %
# LIVE_MEM_REGIME_EW_DROP_PCT=1 — сигнал: equal-weight средний доход ≤ −N п.п.
# LIVE_MEM_REGIME_MED_DROP_PCT=0.8 — сигнал: median доход ≤ −N п.п.
# LIVE_MEM_REGIME_REQUIRED_SIGNALS=2 — risk-off при ≥ N из 3 сигналов
# LIVE_MEM_REGIME_CONFIRM_WINDOWS=2 — гистерезис: подряд окон для смены режима
# LIVE_MEM_REGIME_MAX_STALE_SEC=300 — старше = fail-open (unknown)
# LIVE_MEM_REGIME_JOURNAL_EVERY_SEC=600 — периодический снимок режима в live-журнал
# --- Чёрный лебедь (RCA 4–5 июня / 6–7 июля): ликвидация ВСЕХ позиций при глубоком одновременном сливе топ-раннеров ---
# LIVE_MEM_SWAN_ENABLED=0 — мастер-флаг (default off)
# LIVE_MEM_SWAN_MODE=off — off|shadow|liquidate; shadow журналит какие позиции закрыл бы, liquidate продаёт
# LIVE_MEM_SWAN_REFRESH_SEC=60 — фон обновления индекса (вне hot-path)
# LIVE_MEM_SWAN_ROLL_MIN=360 — окно equal-weight возврата вселенной раннеров (мин)
# LIVE_MEM_SWAN_BASELINE_TOL_MIN=30 — запас окна снапшотов для baseline
# LIVE_MEM_SWAN_TOP_N=80 — вселенная: топ-N по пиковому 1h-объёму
# LIVE_MEM_SWAN_MIN_RUNNER_V1H_USD=10000 — раннер = пиковый 1h-объём ≥ этого
# LIVE_MEM_SWAN_MIN_RUNNERS=40 — анти-фантом: ниже = слепые данные, не ликвидируем
# LIVE_MEM_SWAN_EW_DROP_PCT=16 — триггер: equal-weight падение ≥ N% (мгновенно, без breadth/подтверждения)
# LIVE_MEM_SWAN_MAX_STALE_SEC=900 — кэш старше = unknown, не ликвидируем (fail-safe)
# LIVE_MEM_SWAN_RESUME_MIN=180 — сброс active после N мин валидного затишья
# LIVE_MEM_SWAN_JOURNAL_EVERY_SEC=600 — периодический снимок индекса лебедя в live-журнал
# --- OWN-BOOK лебедь / портфельный стоп (независим от индекса топ-80; по нашим маркам) ---
# LIVE_MEM_SWAN_PORT_ENABLED=0 — вкл own-book детектор
# LIVE_MEM_SWAN_PORT_MODE=off — off|shadow|liquidate
# LIVE_MEM_SWAN_PORT_ROLL_MIN=360 — окно EW-просадки нашего портфеля (мин)
# LIVE_MEM_SWAN_PORT_BASELINE_TOL_MIN=30 — допуск на baseline
# LIVE_MEM_SWAN_PORT_EW_DROP_PCT=25 — триггер: EW нашего book ≤ −этих %
# LIVE_MEM_SWAN_PORT_MIN_POSITIONS=8 — анти-фантом/прогрев: минимум участвующих позиций
# LIVE_MEM_SWAN_PORT_MAX_STALE_SEC=180 — кэш тика старше → не ликвидируем
# LIVE_MEM_SWAN_PORT_RESUME_MIN=120 — сброс active после затишья (мин)
# LIVE_MEM_SWAN_PORT_JOURNAL_EVERY_SEC=600 — снимок own-book индекса в журнал
# LIVE_BTC_GATE_TELEGRAM_ENABLED=0 — выкл. алерты
# LIVE_ENTRY_NOTIONAL_USD=
# LIVE_PHASE5_FREE_SOL_GATE_ENABLED=0 — дефолт в коде: не проверять free SOL ≥ k·X перед входом (нет capital_skip / ротации на этом пути). 1 = включить W8.0 §3.4
# LIVE_ENTRY_MIN_FREE_MULT=2 — только если гейт включён: нужно ≥ k×X свободного SOL (USD)
# LIVE_CAPITAL_ROTATE_ENABLED=0 — только если гейт включён: 1 = можно CAPITAL_ROTATE при нехватке SOL
# LIVE_CAPITAL_ROTATE_CASCADE=0
# LIVE_FREE_SOL_BUFFER_LAMPORTS=50000000  # fee reserve (0.05 SOL); spendable = balance − buffer
# LIVE_PARTIAL_BUY_MIN_USD=50  # partial entry slice floor when wallet short (0 = legacy hard block)
# LIVE_EXIT_SLICE_MAX_USD=400 — max USD per Jupiter sell slice on partial TP, kill stop, full close (0 = off)
# LIVE_EXIT_SLICE_BYPASS_BELOW_USD=100 — chain-capped exit ≤ N USD → one sell_full, no multi-slice (0 = tail/max only)
# LIVE_EXIT_SLICE_DELAY_MS=10000 — pause between exit slices when notional exceeds max
# LIVE_ENTRY_SLICE_MAX_USD=500 — max USD per Jupiter buy slice on staged_avg / entry_split (low+prod tier; 0 = off)
# LIVE_ENTRY_SLICE_DELAY_MS=10000 — pause between entry buy slices when notional exceeds max
# LIVE_SOL_USD_MAX_AGE_MS=30000  # max cache age before buy refetches Jupiter SOL/USD (1.11.507)

# W8.0 Phase 6 — sendTransaction + confirm (см. CHANGELOG 1.9.0; канарейка: не включать live без лимитов §3.3–§3.4)
# LIVE_CONFIRM_COMMITMENT=confirmed
